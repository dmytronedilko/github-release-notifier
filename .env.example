# PostgreSQL credentials (used by both the db service and DATABASE_URL above)
POSTGRES_USER=notifier_user
POSTGRES_PASSWORD=notifier_pass
POSTGRES_DB=notifier_db
DATABASE_URL=postgres://notifier_user:notifier_pass@localhost:5433/notifier_db

# GitHub OAuth App credentials (required for user login)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Set "Authorization callback URL" to: ${APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Redis URL for caching GitHub API responses (10-minute TTL)
# If not set, every request goes directly to the GitHub API
REDIS_URL=redis://localhost:6379

# Brevo configuration (https://brevo.com)
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_NAME=GitHub Release Notifier
BREVO_SENDER_EMAIL=notifications@yourdomain.com

# Base URL for confirmation/unsubscribe links in emails
APP_BASE_URL=http://localhost:3000

# Background scanner cron schedule (default: every 5 minutes)
SCAN_CRON=*/5 * * * *

# Trust X-Forwarded-* headers from reverse proxy (set to true behind nginx/load balancer)
TRUST_PROXY=false

# Port to listen on
PORT=3000

# gRPC server port
GRPC_PORT=50051

#Node environment
NODE_ENV=production