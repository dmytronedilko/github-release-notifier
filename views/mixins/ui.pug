mixin eyeIcon
  svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
    path(d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z")
    circle(cx="12" cy="12" r="3")

mixin copyIcon
  svg(width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
    rect(x="9" y="9" width="13" height="13" rx="2" ry="2")
    path(d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1")

mixin trashIcon
  svg(width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
    polyline(points="3 6 5 6 21 6")
    path(d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6")
    path(d="M10 11v6")
    path(d="M14 11v6")
    path(d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2")

//- ── Components ─────────────────────────────────────────────────────────────

//- Password input with visibility toggle. Pass extra attrs (required, readonly)
//- via mixin call attributes; use block to inject additional buttons into the row.
mixin passwordRow(id, placeholder)
  .key-row(style="margin-bottom: 0")
    .field(style="margin-bottom: 0")
      input(id=id type="password" placeholder=placeholder autocomplete="off")&attributes(attributes)
    button.icon-btn(type="button" title="Toggle visibility" onclick=`toggleVis('${id}', this)`)
      +eyeIcon
    block

//- GitHub OAuth login prompt section.
mixin githubLoginSection(sectionId, text)
  .github-login-section(id=sectionId)
    p= text
    button.btn-github(onclick="window.location.href=API+'/auth/github'")
      +githubMark(18, '#fff')
      | Sign in with GitHub
