doctype html
html(lang="en" xmlns="http://www.w3.org/1999/xhtml")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="dark")
    meta(name="supported-color-schemes" content="dark")
    title GitHub Release Notifier
    | <!--[if mso]><style>table,td{font-family:Arial,Helvetica,sans-serif;}</style><![endif]-->
  body(style=`margin:0;padding:0;background-color:${colors.bg};font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;`)
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style=`background-color:${colors.bg};`)
      tr
        td(align="center" style="padding:40px 16px;")
          table(role="presentation" width="520" cellspacing="0" cellpadding="0" border="0" style=`max-width:520px;width:100%;background-color:${colors.surface};border:1px solid ${colors.border};border-radius:12px;overflow:hidden;`)

            //- Header
            tr
              td(style="padding:28px 32px 0 32px;")
                table(role="presentation" cellspacing="0" cellpadding="0" border="0")
                  tr
                    td(style="vertical-align:middle;padding-right:14px;")
                      img(src="https://github.githubassets.com/favicons/favicon-dark.svg" width="32" height="32" alt="" style="display:block;")
                    td(style="vertical-align:middle;")
                      p(style=`margin:0;font-size:17px;font-weight:600;color:${colors.text};line-height:1.3;`) GitHub Release Notifier
                      p(style=`margin:2px 0 0;font-size:13px;color:${colors.muted};line-height:1.3;`) Release notifications for your favourite repos

            //- Divider
            tr
              td(style="padding:20px 32px 0 32px;")
                div(style=`height:1px;background-color:${colors.border};`)

            //- Content slot
            tr
              td(style="padding:24px 32px 32px 32px;")
                block content

            //- Footer
            tr
              td(style="padding:0 32px 28px 32px;")
                div(style=`height:1px;background-color:${colors.border};margin-bottom:20px;`)
                p(style=`margin:0;font-size:12px;color:${colors.muted};line-height:1.6;text-align:center;`)
                  | Sent by&nbsp;
                  span(style=`color:${colors.text};`) GitHub Release Notifier
                  br
                  | You received this email because of your subscription settings.
