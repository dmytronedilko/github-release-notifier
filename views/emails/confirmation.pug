extends ./layout.pug

block content
  //- Icon badge
  table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto 20px;")
    tr
      td(style="width:56px;height:56px;border-radius:50%;background-color:rgba(47,129,247,0.12);text-align:center;vertical-align:middle;")
        img(src="https://img.icons8.com/sf-regular-filled/48/388bfd/new-post.png" width="28" height="28" alt="" style="display:inline-block;")

  h2(style=`margin:0 0 8px;font-size:20px;font-weight:600;color:${colors.text};text-align:center;line-height:1.3;`) Confirm your subscription
  p(style=`margin:0 0 24px;font-size:14px;color:${colors.muted};text-align:center;line-height:1.6;`)
    | Thank you for subscribing to GitHub release notifications.
    br
    | Please click the button below to verify your email address.

  //- CTA Button
  table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;")
    tr
      td(style=`border-radius:8px;background-color:${colors.accent};`)
        a(href=confirmUrl target="_blank" style=`display:inline-block;padding:12px 32px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;line-height:1;`) Confirm email address

  //- Fallback link
  p(style=`margin:20px 0 0;font-size:12px;color:${colors.muted};text-align:center;line-height:1.6;word-break:break-all;`)
    | Or copy this link:
    br
    a(href=confirmUrl style=`color:${colors.accent};text-decoration:none;`)= confirmUrl

  //- Info note
  table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 0;width:100%;")
    tr
      td(style="padding:12px 16px;border-radius:8px;background-color:rgba(47,129,247,0.08);border:1px solid rgba(47,129,247,0.2);")
        p(style=`margin:0;font-size:13px;color:${colors.accent};line-height:1.5;`) If you did not subscribe, you can safely ignore this email.
