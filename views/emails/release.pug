extends ./layout.pug

block content
  //- Icon badge
  table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto 20px;")
    tr
      td(style=`width:56px;height:56px;border-radius:50%;background-color:rgba(63,185,80,0.12);text-align:center;vertical-align:middle;font-size:26px;line-height:56px;color:${colors.success};`) 🏷

  h2(style=`margin:0 0 8px;font-size:20px;font-weight:600;color:${colors.text};text-align:center;line-height:1.3;`) New Release Published
  p(style=`margin:0 0 24px;font-size:14px;color:${colors.muted};text-align:center;line-height:1.6;`) A repository you follow has shipped a new version.

  //- Release card
  table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin-bottom:24px;")
    tr
      td(style=`padding:16px 20px;border-radius:10px;background-color:${colors.bg};border:1px solid ${colors.border};`)
        table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;")
          tr
            td(style="vertical-align:middle;padding-right:12px;width:36px;")
              img(src="https://img.icons8.com/sf-regular-filled/48/7d8590/repository.png" width="24" height="24" alt="" style="display:block;")
            td(style="vertical-align:middle;")
              p(style=`margin:0;font-size:14px;color:${colors.muted};line-height:1.3;`)
                span(style=`color:${colors.text};font-weight:500;`)= owner
                span(style=`color:${colors.muted};padding:0 4px;`) /
                span(style=`color:${colors.text};font-weight:600;`)= repoName
            td(style="vertical-align:middle;text-align:right;")
              span(style=`display:inline-block;padding:4px 12px;border-radius:20px;background-color:rgba(63,185,80,0.15);font-size:13px;font-weight:600;color:${colors.success};line-height:1;`)= tag

  //- CTA Button
  table(role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 auto;")
    tr
      td(style=`border-radius:8px;background-color:${colors.accent};`)
        a(href=releaseUrl target="_blank" style=`display:inline-block;padding:12px 32px;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px;line-height:1;`) View release on GitHub

  //- Unsubscribe
  p(style=`margin:24px 0 0;font-size:12px;color:${colors.muted};text-align:center;line-height:1.6;`)
    | Don't want these emails?&nbsp;
    a(href=unsubscribeUrl style=`color:${colors.muted};text-decoration:underline;`) Unsubscribe
